# ===========================================================
# Flash-Archi SaaS — Configuration d'environnement
# Copiez ce fichier vers `.env` et remplissez vos valeurs.
# (Ne documentez jamais de secret réel dans un commit.)
# ===========================================================

# --- Serveur -------------------------------------------------
PORT=8094
HOST=0.0.0.0
NODE_ENV=development

# --- Authentification API ------------------------------------
# Active la protection par clé API (toutes les routes /api/).
# En dev avec provider=mock vous pouvez la laisser sur false.
AUTH_ENABLED=false
API_KEY=change-me-strong-random-key

# --- Rate limiting -------------------------------------------
# Limite de base sur toute l'API /api/ (par IP, via express-rate-limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Politique Hermes Agent ----------------------------------
# DENY BY DEFAULT : seuls les outils listés sont autorisés (séparés par des virgules).
HERMES_DENY_ALL_BY_DEFAULT=true
HERMES_ALLOWED_TOOLS=
# Mode non-deny-all alternatif : liste des outils refusés.
HERMES_DENIED_TOOLS=terminal,browser_use,web_search,web_extract,write_file,patch,cronjob,skill_manage,memory

# --- Observabilité -------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Persistance ---------------------------------------------
# Chemin du fichier SQLite (jobs + cache). Vide = mémoire seulement.
DB_PATH=./data/flash-archi.db

# --- Sauvegarde ----------------------------------------------
# Dossier où seront écrites les sauvegardes (scripts/backup-db.js)
BACKUP_DIR=./backups

# --- Provider LLM par défaut ---------------------------------
# Valeurs: openrouter | groq | ollama | mock
LLM_PROVIDER=mock
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2

# Clé API du provider sélectionné (soustraite depuis l'environnement)
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Ollama (fallback local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FALLBACK_MODEL=llama3.1:8b

# --- Provider LLM réel (Phase 3B) ---
# Choix recommandé pour un LLM local CPU : qwen2.5:3b-instruct (bon JSON).
# En prod cloud : seekai / openrouter / groq (voir sections ci-dessous).
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b-instruct
# OLLAMA_BASE_URL=http://ollama:11434   # host=localhost, via npm-net=ollama

# --- Routage & cache ------------------------------------------
ROUTING_STRATEGY=cost_quality_balance
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=500

# --- Paiement Orange Money Burkina (P3-03) ----------------------
# Intégration directe (sans agrégateur). Identifiants fournis par
# Orange Burkina via developer.orange.com (projet om-webpay).
# ORANGE_API_ENV=test utilise le sandbox Orange (api-s2).
# NB : CLIENT_SECRET ne doit JAMAIS être commité (voir .gitignore).
ORANGE_API_ENV=test          # test | prod
ORANGE_CLIENT_ID=your_client_id
ORANGE_CLIENT_SECRET=your_client_secret
ORANGE_MERCHANT_KEY=your_merchant_key
# Secret partagé pour la vérification HMAC-SHA256 des webhooks Orange
# (header X-Orange-Signature). OBLIGATOIRE en production.
# NB : en dev/démo laisse-le vide pour permettre les webhooks non signés.
ORANGE_WEBHOOK_SECRET=your_webhook_secret_here
# URLs de retour (doivent être atteignables publiquement).
# En dev, utilisez ngrok pour exposer ces URLs (webhook inclus).
ORANGE_RETURN_URL=https://app.flash-archi.com/checkout/success
ORANGE_CANCEL_URL=https://app.flash-archi.com/checkout/cancel
ORANGE_NOTIF_URL=https://api.flash-archi.com/api/payment/orange/webhook